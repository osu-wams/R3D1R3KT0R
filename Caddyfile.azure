	# END INTEGRATIVE BIOLOGY WEBSITES
	# =========================================================================

	# =========================================================================
	# START MATHEMATICS WEBSITES
	# Mixed redirect types — see per-rule notes.  All rules are 301 permanent.
	# =========================================================================

	# Specific paths redirected; all other traffic proxied to Drupal on Acquia Edge
	# with Host header preserved so the CDN routes to the correct site.
	@math-oregonstate host math.oregonstate.edu
	handle @math-oregonstate {
		redir /BridgeBook   https://sites.science.oregonstate.edu/math/BridgeBook 301
		redir /BridgeBook/* https://sites.science.oregonstate.edu/math{uri}       301
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
	}

	# Whole-domain redirect to a fixed URL; path is intentionally not forwarded.
	@calendar-math host calendar.math.oregonstate.edu
	handle @calendar-math {
		redir * https://internal.math.oregonstate.edu/room-reservations 301
	}

	# END MATHEMATICS WEBSITES
	# =========================================================================

	# =========================================================================
	# START MICROBIOLOGY WEBSITES
	# Redirects legacy microbiology-related subdomains to canonical destinations.
	# All rules are 301 permanent.
	# Note: core-values redirects to a fixed URL path; incoming path not forwarded.
	# Note: biohealth.science and microbiology.science share a target — combined rule.
	# =========================================================================

	@microbiology-science host biohealth.science.oregonstate.edu microbiology.science.oregonstate.edu
	handle @microbiology-science {
		redir * https://microbiology.oregonstate.edu{uri} 301
	}

	# Whole-domain redirect to a fixed URL; path is intentionally not forwarded.
	@core-values-microbiology host core-values.microbiology.oregonstate.edu
	handle @core-values-microbiology {
		redir * https://microbiology.oregonstate.edu/our-department/diversity-and-inclusion/core-values 301
	}

	@davidlab-science host davidlab.science.oregonstate.edu
	handle @davidlab-science {
		redir * https://davidlab.microbiology.oregonstate.edu{uri} 301
	}

	@ephys-science host ephys.science.oregonstate.edu
	handle @ephys-science {
		redir * https://ephys.microbiology.oregonstate.edu{uri} 301
	}

	# All traffic proxied to Drupal on Acquia Edge; Host header preserved.
	@microbiology host microbiology.oregonstate.edu
	handle @microbiology {
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
	}

	# END MICROBIOLOGY WEBSITES
	# =========================================================================

	# =========================================================================
	# START PHYSICS WEBSITES
	# Large mixed set: path-specific redirects on physics.oregonstate.edu, plus
	# subdomain and cross-domain rules.  All rules are 301 permanent.
	# Notes:
	#   - /BridgeBook has both exact and wildcard rules to cover subpaths.
	#   - / redirects the root only; all other unlisted paths proxy to Drupal backend.
	#   - /~grahamat/COURSES/ph411 listed before /~grahamat (more specific first).
	#   - /~grahamat redirects within the same domain to /directory/matt-w-graham.
	#   - /~minote and /~walshke redirect to separate subdomains; path not forwarded.
	#   - /~tevian appends /physics suffix; path not forwarded.
	#   - calendar.physics uses a fixed URL; path intentionally not forwarded.
	# =========================================================================

	@physics-oregonstate host physics.oregonstate.edu
	handle @physics-oregonstate {
		# BridgeBook — exact path and wildcard subpaths both point to math target
		redir /BridgeBook     https://sites.science.oregonstate.edu/math/BridgeBook 301
		redir /BridgeBook/*   https://sites.science.oregonstate.edu/math{uri}       301
		# Root redirect (/ only — not a catch-all)
		redir /               https://sites.science.oregonstate.edu/physics/meetings 301
		# Named paths
		redir /energetics     https://sites.science.oregonstate.edu/physics/energetics   301
		redir /forum          https://sites.science.oregonstate.edu/forum                301
		redir /gradreview     https://sites.science.oregonstate.edu/physics/gradreview   301
		redir /mentorwiki     https://sites.science.oregonstate.edu/physics/mentorwiki   301
		redir /portfolioswiki https://sites.science.oregonstate.edu/physics/portfolioswiki 301
		redir /qmaactivities  https://sites.science.oregonstate.edu/physics/coursewikis/portfolioswiki/topic_qmtext.html 301
		redir /wngrspace      https://sites.science.oregonstate.edu/physics/wngrspace    301
		# Personal pages — /~grahamat/COURSES/ph411 before /~grahamat (more specific first)
		redir /~grahamat/COURSES/ph411 https://sites.science.oregonstate.edu/~grahamat/COURSES/ph411 301
		redir /~craigda  https://sites.science.oregonstate.edu/~craigda                  301
		redir /~grahamat https://physics.oregonstate.edu/directory/matt-w-graham         301
		redir /~lazzatid https://sites.science.oregonstate.edu/~lazzatid                 301
		redir /~leeys    https://sites.science.oregonstate.edu/~leeys                    301
		redir /~mcintyre https://sites.science.oregonstate.edu/~mcintyre                 301
		redir /~minote   https://minotlab.physics.oregonstate.edu                        301
		redir /~ostroveo https://sites.science.oregonstate.edu/~ostroveo                 301
		redir /~schellmh https://sites.science.oregonstate.edu/~schellmh                 301
		redir /~sunb     https://sites.science.oregonstate.edu/~sunb                     301
		redir /~tatej    https://sites.science.oregonstate.edu/~tatej                    301
		redir /~tevian   https://sites.science.oregonstate.edu/~tevian/physics           301
		redir /~walshke  https://boxsand.physics.oregonstate.edu                         301
		# All other paths proxied to Drupal backend; Host header preserved.
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
	}

	@www-physics-orst host www.physics.orst.edu
	handle @www-physics-orst {
		redir * https://physics.oregonstate.edu{uri} 301
	}

	# Whole-domain redirect to a fixed URL; path is intentionally not forwarded.
	@calendar-physics host calendar.physics.oregonstate.edu
	handle @calendar-physics {
		redir * https://physics.oregonstate.edu/our-department/internal-resources/room-reservations 301
	}

	@osuper-science host osuper.science.oregonstate.edu
	handle @osuper-science {
		redir * https://osuper.physics.oregonstate.edu{uri} 301
	}

	# END PHYSICS WEBSITES
	# =========================================================================

	# =========================================================================
	# START STATISTICS WEBSITES
	# Redirects legacy orst.edu subdomain to canonical destination.  301 permanent.
	# =========================================================================

	@www-stat-orst host www.stat.orst.edu
	handle @www-stat-orst {
		redir * https://stat.oregonstate.edu{uri} 301
	}

	# -------------------------------------------------------------------------
	# START MYOPINION SURVEYS
	# Path-specific redirects on myopinion.oregonstate.edu to Qualtrics survey
	# forms.  Root redirects to the Surveys Research Center page.  301 permanent.
	# Note: /dmv and /DMV are case variants of the same form — both rules required
	# as Caddy path matching is case-sensitive.
	# -------------------------------------------------------------------------

	@myopinion host myopinion.oregonstate.edu
	handle @myopinion {
		# Root → Surveys Research Center (fixed URL; path not forwarded)
		redir /         https://stat.oregonstate.edu/services/surveys-research-center 301
		# Survey form redirects — fixed Qualtrics URLs; path not forwarded
		redir /air      https://oregonstate.qualtrics.com/jfe/form/SV_4U4U0yNKbbb6cdM 301
		redir /dmv      https://oregonstate.qualtrics.com/jfe/form/SV_eDLNjMhZv6ypF8F 301
		redir /DMV      https://oregonstate.qualtrics.com/jfe/form/SV_eDLNjMhZv6ypF8F 301
		redir /highways https://oregonstate.qualtrics.com/jfe/form/SV_cV1pv3aJekkNdgp 301
		redir /roads    https://oregonstate.qualtrics.com/jfe/form/SV_3Jo5ThHFp5J222O 301
	}

	# END MYOPINION SURVEYS
	# -------------------------------------------------------------------------

	# All traffic proxied to Drupal on Acquia Edge; Host header preserved.
	@stat host stat.oregonstate.edu
	handle @stat {
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
	}

	# END STATISTICS WEBSITES
	# =========================================================================
}
