{
	admin off
	auto_https off   # Azure ingress owns TLS; Caddy only handles HTTP internally on :80
}

:80 {
	log {
		format json
		output stdout
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options   nosniff
		X-Frame-Options          DENY
		Referrer-Policy          strict-origin-when-cross-origin
		-Server
	}

	# --- Single-domain redirect rules ---
	# If all custom domains configured on the Azure Container App ingress share the same
	# rules, add redir lines here directly (no host matcher needed).
	#
	# redir /old-path          https://destination.example.com          301
	# redir /temporary-promo   https://promo.example.com                302

	# --- Multi-domain routing ---
	# Azure Container Apps preserves the Host header for custom domains, so Caddy can
	# route by hostname even though it only binds :80. Define a named matcher per domain
	# set, then wrap its redirect rules in a handle block.
	#
	# @example-com host example.com www.example.com
	# handle @example-com {
	# 	redir /old-path          https://destination.example.com          301
	# 	redir /temporary-promo   https://promo.example.com                302
	# 	# Wildcard: {uri} = full path + query string
	# 	# e.g. GET /blog/my-post?ref=tw → https://blog.example.com/blog/my-post?ref=tw
	# 	redir /blog/*            https://blog.example.com{uri}            301
	# }
	#
	# @anotherdomain host anotherdomain.com
	# handle @anotherdomain {
	# 	redir /old               https://new.anotherdomain.com            301
	# }

	# =========================================================================
	# START CoS COLLEGE OF SCIENCE WEBSITES
	# Redirects for College of Science (CoS) canonical destinations.
	# All rules are 301 permanent.
	# Notes:
	#   - environmental/envsci/envscinew all target the same fixed URL — combined rule.
	#   - naci redirects to research.oregonstate.edu root; URI preserved.
	#   - science.oregonstate.edu/bpp redirects to domain root; path not forwarded.
	# =========================================================================

	@cosine host cosine.oregonstate.edu
	handle @cosine {
		redir * https://technology.oregonstate.edu/help 301
	}

	@envsci-science host environmental.science.oregonstate.edu envsci.science.oregonstate.edu envscinew.science.oregonstate.edu
	handle @envsci-science {
		redir * https://graduate.oregonstate.edu/environmental-sciences-graduate-program-esgp 301
	}

	@healthprofessions-science host healthprofessions.science.oregonstate.edu
	handle @healthprofessions-science {
		redir * https://science.oregonstate.edu/premed/premed-application/healthprofessions 301
	}

	@impact host impact.oregonstate.edu
	handle @impact {
		redir * https://science.oregonstate.edu/impact 301
	}

	@naci-science host naci.science.oregonstate.edu
	handle @naci-science {
		redir * https://research.oregonstate.edu{uri} 301
	}

	@proposals-science host proposals.science.oregonstate.edu
	handle @proposals-science {
		redir * https://internal.science.oregonstate.edu/rdu/ecos 301
	}

	# Specific paths redirected; all other traffic proxied to Drupal on Acquia Edge
	# with Host header preserved so the CDN routes to the correct site.
	@science-oregonstate host science.oregonstate.edu
	handle @science-oregonstate {
		redir /bgss               https://sites.science.oregonstate.edu/bgss               301
		redir /bi311              https://sites.science.oregonstate.edu/bi311              301
		redir /bpp                https://bpp.oregonstate.edu                              301
		redir /ocean.productivity https://orca.science.oregonstate.edu/ocean.productivity  301
		redir /osumi              https://sites.science.oregonstate.edu/osumi              301
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
	}

	# END CoS COLLEGE OF SCIENCE WEBSITES
	# =========================================================================

	# =========================================================================
	# START BIOCHEM WEBSITES
	# Redirects legacy *.science.oregonstate.edu subdomains to canonical
	# biochemistry department destinations.  All rules are 301 permanent.
	# =========================================================================

	@barbar-science host barbar.science.oregonstate.edu
	handle @barbar-science {
		redir * https://barbar.biochem.oregonstate.edu{uri} 301
	}

	@bb host bb.oregonstate.edu
	handle @bb {
		redir * https://biochem.oregonstate.edu{uri} 301
	}

	@biochem-science host biochem.science.oregonstate.edu
	handle @biochem-science {
		redir * https://biochem.oregonstate.edu{uri} 301
	}

	@ccf-science host ccf.science.oregonstate.edu
	handle @ccf-science {
		redir * https://gce4all.oregonstate.edu{uri} 301
	}

	@gombart-science host gombart.science.oregonstate.edu
	handle @gombart-science {
		redir * https://gombart.biochem.oregonstate.edu{uri} 301
	}

	@mehl-science host mehl.science.oregonstate.edu
	handle @mehl-science {
		redir * https://mehl.biochem.oregonstate.edu{uri} 301
	}

	@upf-science host upf.science.oregonstate.edu
	handle @upf-science {
		redir * https://upf.biochem.oregonstate.edu{uri} 301
	}

	# All traffic proxied to Drupal on Acquia Edge; Host header preserved.
	@biochem host biochem.oregonstate.edu
	handle @biochem {
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
	}

	# END BIOCHEM WEBSITES
	# =========================================================================

	# =========================================================================
	# START CEOAS WEBSITES
	# Redirects legacy geo.* and related subdomains to the College of Earth, Ocean,
	# and Atmospheric Sciences (CEOAS) canonical destinations.  All rules are 301 permanent.
	# =========================================================================

	@geo-oregonstate host geo.oregonstate.edu www.geo.oregonstate.edu
	handle @geo-oregonstate {
		redir * https://ceoas.oregonstate.edu{uri} 301
	}

	@geo-orst host geo.orst.edu www.geo.orst.edu
	handle @geo-orst {
		redir * https://ceoas.oregonstate.edu{uri} 301
	}

	@geo-science host geo.science.oregonstate.edu
	handle @geo-science {
		redir * https://ceoas.oregonstate.edu{uri} 301
	}

	@icecorelab-science host icecorelab.science.oregonstate.edu
