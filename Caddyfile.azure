		redir * https://mass-spec.chem.oregonstate.edu{uri} 301
	}

	@remcho-science host remcho.science.oregonstate.edu
	handle @remcho-science {
		redir * https://remcho.chem.oregonstate.edu{uri} 301
	}

	@subramanian-science host subramanian.science.oregonstate.edu
	handle @subramanian-science {
		redir * https://subramanian.chem.oregonstate.edu{uri} 301
	}

	@xrd-chem host xrd.chem.oregonstate.edu
	handle @xrd-chem {
		redir * https://xrd.science.oregonstate.edu{uri} 301
	}

	# All traffic proxied to Drupal on Acquia Edge; Host header preserved.
	@chemistry host chemistry.oregonstate.edu
	handle @chemistry {
		reverse_proxy https://oregonstate.acquiaedge.net {
			header_up Host {host}
		}
