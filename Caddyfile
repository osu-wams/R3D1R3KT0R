# =============================================================================
# START PHYSICS WEBSITES
# Large mixed set: path-specific redirects on physics.oregonstate.edu, plus
# subdomain and cross-domain rules.  All rules are 301 permanent.
# Notes:
#   - /BridgeBook has both exact and wildcard rules to cover subpaths.
#   - / redirects the root only; all other unlisted paths proxy to Drupal backend.
#   - /~grahamat/COURSES/ph411 listed before /~grahamat (more specific first).
#   - /~grahamat redirects within the same domain to /directory/matt-w-graham.
#   - /~minote and /~walshke redirect to separate subdomains; path not forwarded.
#   - /~tevian appends /physics suffix; path not forwarded.
#   - calendar.physics uses a fixed URL; path intentionally not forwarded.
# =============================================================================

physics.oregonstate.edu {
	import shared
	# BridgeBook — exact path and wildcard subpaths both point to math target
	redir /BridgeBook     https://sites.science.oregonstate.edu/math/BridgeBook 301
	redir /BridgeBook/*   https://sites.science.oregonstate.edu/math{uri}       301
	# Root redirect (/ only — not a catch-all)
	redir /               https://sites.science.oregonstate.edu/physics/meetings 301
	# Named paths
	redir /energetics     https://sites.science.oregonstate.edu/physics/energetics   301
	redir /forum          https://sites.science.oregonstate.edu/forum                301
	redir /gradreview     https://sites.science.oregonstate.edu/physics/gradreview   301
	redir /mentorwiki     https://sites.science.oregonstate.edu/physics/mentorwiki   301
	redir /portfolioswiki https://sites.science.oregonstate.edu/physics/portfolioswiki 301
	redir /qmaactivities  https://sites.science.oregonstate.edu/physics/coursewikis/portfolioswiki/topic_qmtext.html 301
	redir /wngrspace      https://sites.science.oregonstate.edu/physics/wngrspace    301
	# Personal pages — /~grahamat/COURSES/ph411 before /~grahamat (more specific first)
	redir /~grahamat/COURSES/ph411 https://sites.science.oregonstate.edu/~grahamat/COURSES/ph411 301
	redir /~craigda  https://sites.science.oregonstate.edu/~craigda                  301
	redir /~grahamat https://physics.oregonstate.edu/directory/matt-w-graham         301
	redir /~lazzatid https://sites.science.oregonstate.edu/~lazzatid                 301
	redir /~leeys    https://sites.science.oregonstate.edu/~leeys                    301
	redir /~mcintyre https://sites.science.oregonstate.edu/~mcintyre                 301
	redir /~minote   https://minotlab.physics.oregonstate.edu                        301
	redir /~ostroveo https://sites.science.oregonstate.edu/~ostroveo                 301
	redir /~schellmh https://sites.science.oregonstate.edu/~schellmh                 301
	redir /~sunb     https://sites.science.oregonstate.edu/~sunb                     301
	redir /~tatej    https://sites.science.oregonstate.edu/~tatej                    301
	redir /~tevian   https://sites.science.oregonstate.edu/~tevian/physics           301
	redir /~walshke  https://boxsand.physics.oregonstate.edu                         301
	# All other paths proxied to Drupal backend; Host header preserved.
	reverse_proxy https://oregonstate.acquiaedge.net {
		header_up Host {host}
	}
}

# Whole-domain redirect preserving URI.
www.physics.orst.edu {
	import shared
	redir * https://physics.oregonstate.edu{uri} 301
}

# Whole-domain redirect to a fixed URL; path is intentionally not forwarded.
calendar.physics.oregonstate.edu {
	import shared
	redir * https://physics.oregonstate.edu/our-department/internal-resources/room-reservations 301
}

osuper.science.oregonstate.edu {
	import shared
	redir * https://osuper.physics.oregonstate.edu{uri} 301
}

# END PHYSICS WEBSITES
